# --- Database ---------------------------------------------------------
# Local development (docker compose up -d db):
DATABASE_URL=postgresql://tms:tms@localhost:5433/tms
DIRECT_URL=postgresql://tms:tms@localhost:5433/tms
# Supabase: use the transaction pooler (6543) at runtime and the session
# pooler (5432) for schema changes.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Integration tests run against their own database and wipe it on every run.
TEST_DATABASE_URL=postgresql://tms:tms@localhost:5433/tms_test

# --- Auth -------------------------------------------------------------
# Signs session cookies. Required. Generate with: openssl rand -hex 32
AUTH_SECRET=

# --- Routing ----------------------------------------------------------
# "haversine" (default, no external service) or "osrm".
ROUTING_PROVIDER=haversine
# Base URL of an OSRM server, e.g. http://localhost:5000
OSRM_URL=

# --- Map tiles (browser) ----------------------------------------------
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# --- Demo data --------------------------------------------------------
# Password for the seeded demo admin (demo@northstar.example).
SEED_PASSWORD=northstar-demo
